.env
.env.*
__pycache__/
*.pyc
.venv/
node_modules/
dist/
all_fixes.patch

# Local working reports and checklists
reports/
Sample paper/

# Scratch test files and artifacts.
#
# `test_*.py` was unanchored, so it matched at every depth and hid the whole
# `backend/tests/` suite: files already committed still showed as tracked, but
# every *new* test was invisible to `git status` and would have been dropped
# from its own commit. Anchored to the repo root, with the real suite un-ignored.
/test_*.py
!backend/tests/
!backend/tests/**
*.xml
*.pdf
*.txt


# Logs (including rotated files like backend.log.1)
*.log
*.log.*
backend.log

.cursor/
.claude/
# OAuth client secrets must never be committed. One was found untracked in
# backend/integrations/ on 2026-08-24 - delete it and rotate the credential.
client_secret*.json
*client_secret*.json

# Local agent memory and rules - never committed
CLAUDE.md
